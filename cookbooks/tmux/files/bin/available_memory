#!/bin/bash

if [ $(uname) == 'Darwin' ]; then
  FREE_BLOCKS=$(vm_stat | grep free | awk '{ print $3 }' | sed 's/\.//')
  INACTIVE_BLOCKS=$(vm_stat | grep inactive | awk '{ print $3 }' | sed 's/\.//')
  SPECULATIVE_BLOCKS=$(vm_stat | grep speculative | awk '{ print $3 }' | sed 's/\.//')
  FREE=$((($FREE_BLOCKS+SPECULATIVE_BLOCKS)*4096/1048576))
  INACTIVE=$(($INACTIVE_BLOCKS*4096/1048576))
  TOTAL=$((($FREE+$INACTIVE)))

  SWAP_FREE=$(sysctl -n vm.swapusage | awk '{ for (i = 1; i <= NF; i++) if ($i == "free") print int($(i + 2)) }')

  printf "%04d(+%d)" $TOTAL $SWAP_FREE
else
  TOTAL=$(grep 'MemAvailable' /proc/meminfo | awk '{ print int($2 / 1024) }')
  SWAP_FREE=$(awk 'NR > 1 && $1 !~ "^/dev/zram" { s += $3 - $4 } END { print int(s / 1024) }' /proc/swaps)

  if grep -q '^/dev/zram' /proc/swaps; then
    ZRAM_RATIO=$(cat /sys/block/zram*/mm_stat | awk '{ o += $1; m += $3 } END { if (m > 0) printf "%.1f", o / m; else print "-" }')
    printf "%04d(+%d x%s)" $TOTAL $SWAP_FREE $ZRAM_RATIO
  else
    printf "%04d(+%d)" $TOTAL $SWAP_FREE
  fi
fi

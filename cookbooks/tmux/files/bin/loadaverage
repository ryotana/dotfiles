#!/bin/bash

if [ $(uname) == 'Darwin' ]; then
  cores=$(sysctl -n hw.ncpu)
  loadavg=$(uptime | awk -F\  '{print $(NF - 2),$(NF - 1),$NF}')
else
  cores=$(nproc)
  loadavg=$(uptime | awk -F\  '{print $(NF - 2),$(NF - 1),$NF}' | tr -d ',')
fi

echo "$loadavg" | awk -v c="$cores" '{printf "%.1f %.1f %.1f\n", $1 / c, $2 / c, $3 / c}'
